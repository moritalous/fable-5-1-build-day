---
/**
 * 生成したHTMLそのものを別タブで開くボタン。
 * ファイルは public/demos/ に置き、baseは自動で付与する。
 * 見た目を他ページと揃えるため、StarlightのLinkButtonをそのまま使う。
 */
import { LinkButton } from '@astrojs/starlight/components';

interface Props {
	/** public/demos/ 配下のファイル名。例: 'engine.html' */
	file: string;
	/** ボタンの文言。省略時は表示中の言語に合わせる */
	label?: string;
	/** カメラ・マイクなど、開く前に知らせておきたい注意書き */
	note?: string;
}

const { file, label, note } = Astro.props;
const defaultLabel =
	Astro.currentLocale === 'en' ? 'Open the demo in a new tab' : 'デモを別タブで開く';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/demos/${file}`;
---

<div class="demo-link">
	<LinkButton href={href} target="_blank" rel="noopener noreferrer" icon="external">
		{label ?? defaultLabel}
	</LinkButton>
	{note && <p class="demo-link__note">{note}</p>}
</div>

<style>
	.demo-link {
		margin: 1.5rem 0;
	}

	.demo-link__note {
		margin: 0.6rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
